# Editor / OS
.vscode
.DS_Store

# Compiled objects and libraries
*.o
*.lo
*.la
*.a
*.so
*.dll
*.res
.libs/
.deps/
.dirstamp

# Executables
/arculator
/arculator.exe
/arculator-headless
/arculator-headless.exe
/src/arculator
/src/arculator.exe
/src/arculator-headless
/src/arculator-headless.exe

# Generated by wxrc from src/arculator.xrc
/src/wx-resources.cc

# Autotools / libtool output from ./configure
/autom4te.cache/
/config.log
/config.status
/libtool
/stamp-h1

# Makefiles written by config.status.
# Some of these are tracked upstream; .gitignore does not affect tracked files,
# so this only silences the ones a fresh --enable-podules build newly creates.
/Makefile
/src/Makefile
/podules/*/src/Makefile
/podules/*/src/Makefile.in

# Emulator runtime state and user data
/arc.cfg
/arclog.txt
/modules.dmp
/cmos/*.bin
/configs/*.cfg

# Disc and hard disc images
*.hdf
HardImage[0-9]*

# MCP server scratch output
/mcp/tests/out/
__pycache__/
*.pyc

# ROM images. Acorn's, not ours to redistribute - see roms/*/roms.txt for
# what belongs where.
/roms/**
!/roms/**/
!/roms/**/roms.txt
!/roms/arcrom_ext
